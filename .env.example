# Postgres connection string (required)
# e.g. postgresql://user:password@host:5432/code_review_memory
DATABASE_URL=

# OpenAI API key, used by the review harness (required)
OPENAI_API_KEY=

# GitHub token with repo read access, used to fetch PR diffs (required)
GITHUB_TOKEN=

# Random string used to sign sessions (required in production)
SESSION_SECRET=

# Optional
PORT=5000
LOG_LEVEL=info
