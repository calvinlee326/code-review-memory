# OpenAI API key, used by the review harness (required)
OPENAI_API_KEY=

# GitHub token with repo read access, used to fetch PR diffs (required)
GITHUB_TOKEN=

# Optional
PORT=5000
LOG_LEVEL=info

# Postgres connection string (optional / unused at runtime).
# The app persists to review_memory_store.json; the Drizzle package in
# lib/db is scaffolding and is not imported by the running server.
# DATABASE_URL=postgresql://user:password@host:5432/code_review_memory
